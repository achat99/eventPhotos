PORT=3000
HOST=0.0.0.0
# Für echte Handyscans: öffentliche Domain oder lokale LAN-IP eintragen,
# z. B. https://example.com oder http://192.168.178.50:3000
BASE_URL=
SESSION_SECRET=change-me
ADMIN_PASSWORD=eventphotos123
MAX_UPLOAD_FILE_SIZE_MB=100
MAX_LOOKUP_FILE_SIZE_MB=25
MAX_UPLOAD_FILES=2000
# SMTP-Konfiguration für den Versand von QR-Code und Galerie-Link
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=no
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Event Fotos <noreply@example.com>"
SMTP_ALLOW_INVALID_CERTS=no
# Diese Werte werden nur beim ersten Initialisieren als Startwerte verwendet.
# Danach pflegst du die Event-Konfiguration direkt im Adminbereich unter "Einstellungen".
EVENT_NAME=Musterveranstaltung 2026
EVENT_DATE=2026-05-15
EVENT_SLUG=musterveranstaltung-2026
CONTACT_EMAIL=orga@example.com
