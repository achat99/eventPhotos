<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/styles.css" rel="stylesheet" />
  </head>
  <body>
    <main class="container-fluid py-4 px-lg-4">
      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
          <span class="badge text-bg-dark mb-2">Adminbereich</span>
          <h1 class="h3 mb-1"><%= adminPageTitle %></h1>
          <p class="text-secondary mb-0"><%= adminPageDescription %></p>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-outline-secondary" href="/event/<%= event.slug %>" target="_blank" rel="noreferrer">Öffentliche Ansicht</a>
          <form action="/admin/logout" method="post">
            <button class="btn btn-outline-secondary" type="submit">Abmelden</button>
          </form>
        </div>
      </div>

      <div class="row g-4">
        <aside class="col-12 col-xl-3 col-xxl-2">
          <div class="panel-card card admin-nav-card">
            <div class="card-body p-3">
              <div class="text-uppercase small fw-semibold text-secondary mb-3">Navigation</div>
              <div class="list-group list-group-flush admin-nav-list mb-3">
                <a class="list-group-item list-group-item-action <%= adminSection === 'dashboard' ? 'active' : '' %>" href="/admin/events/<%= event.slug %>">Dashboard</a>
                <a class="list-group-item list-group-item-action <%= adminSection === 'participants' ? 'active' : '' %>" href="/admin/events/<%= event.slug %>/participants">Teilnehmerverwaltung</a>
                <a class="list-group-item list-group-item-action <%= adminSection === 'batches' ? 'active' : '' %>" href="/admin/events/<%= event.slug %>/batches">Neuer Batch &amp; Review</a>
                <a class="list-group-item list-group-item-action <%= adminSection === 'photos' ? 'active' : '' %>" href="/admin/events/<%= event.slug %>/photos">Bildübersicht</a>
                <a class="list-group-item list-group-item-action <%= adminSection === 'settings' ? 'active' : '' %>" href="/admin/events/<%= event.slug %>/settings">Einstellungen</a>
                <a class="list-group-item list-group-item-action <%= adminSection === 'danger' ? 'active' : '' %>" href="/admin/events/<%= event.slug %>/danger">Gefahrenbereich</a>
              </div>

              <div class="admin-event-meta small">
                <div class="text-secondary">Event</div>
                <div class="fw-semibold mb-2"><%= event.name %></div>
                <div class="text-secondary">Datum</div>
                <div class="fw-semibold mb-2"><%= event.date || '–' %></div>
                <div class="text-secondary">Kontakt</div>
                <a class="fw-semibold text-decoration-none" href="mailto:<%= event.contactEmail %>"><%= event.contactEmail %></a>
              </div>
            </div>
          </div>
        </aside>

        <section class="col-12 col-xl-9 col-xxl-10">
          <% if (message) { %>
            <div class="alert alert-success"><%= message %></div>
          <% } %>

          <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>
