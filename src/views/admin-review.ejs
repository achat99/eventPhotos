<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/styles.css" rel="stylesheet" />
  </head>
  <body>
    <main class="container-fluid py-4 px-lg-4">
      <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center mb-4">
        <div>
          <span class="badge text-bg-warning mb-2">Review-Phase</span>
          <h1 class="h3 mb-1">Batch vom <%= batch.createdAt %></h1>
          <p class="text-secondary mb-0">Erkannte Gruppen prüfen, Fotos manuell umsortieren und anschließend freigeben.</p>
        </div>
        <div class="d-flex gap-2">
          <a class="btn btn-outline-secondary" href="/admin/events/<%= event.slug %>">Zum Dashboard</a>
          <form action="/api/batches/<%= batch.id %>/confirm" method="post">
            <button class="btn btn-success" type="submit">Batch freigeben</button>
          </form>
        </div>
      </div>

      <% if (message) { %>
        <div class="alert alert-success"><%= message %></div>
      <% } %>

      <div class="alert alert-light border">
        <strong>Status:</strong> <span class="badge text-bg-<%= batch.status === 'done' ? 'success' : 'warning' %>"><%= batch.status %></span>
        · <strong>Verarbeitet:</strong> <%= batch.processedImages %> / <%= batch.totalImages %>
      </div>

      <% groups.forEach((group) => { %>
        <section class="panel-card card mb-4">
          <div class="group-header card-body border-bottom py-3">
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
              <div>
                <h2 class="h4 mb-1"><%= group.title %></h2>
                <div class="text-secondary small"><%= group.photos.length %> Bilder in dieser Gruppe</div>
              </div>

              <% if (group.participant) { %>
                <form action="/admin/participants/<%= group.participant.id %>" method="post" class="row g-2 align-items-end">
                  <input type="hidden" name="batchId" value="<%= batch.id %>" />
                  <div class="col-sm-5">
                    <label class="form-label small">Vorname</label>
                    <input class="form-control form-control-sm" name="firstname" value="<%= group.participant.firstname %>" required />
                  </div>
                  <div class="col-sm-5">
                    <label class="form-label small">Nachname</label>
                    <input class="form-control form-control-sm" name="lastname" value="<%= group.participant.lastname %>" required />
                  </div>
                  <div class="col-sm-2 d-grid">
                    <button class="btn btn-sm btn-outline-primary" type="submit">Name speichern</button>
                  </div>
                </form>
              <% } %>
            </div>
          </div>

          <div class="card-body p-4">
            <% if (!group.photos.length) { %>
              <div class="text-secondary">Keine Bilder in dieser Gruppe.</div>
            <% } %>

            <div class="row g-4">
              <% group.photos.forEach((photo) => { %>
                <div class="col-sm-6 col-xl-3">
                  <div class="border rounded-4 p-3 h-100 bg-white">
                    <img class="thumb-preview mb-3" src="<%= photo.thumbnailUrl %>" alt="Review-Bild" />
                    <div class="small text-secondary mb-2">Sortierung: <strong><%= photo.sortOrder %></strong></div>
                    <div class="small text-secondary mb-3"><%= photo.originalName %></div>

                    <% if (photo.isBadge) { %>
                      <div class="badge-flag mb-3">QR-Trennmarker</div>
                    <% } %>

                    <% if (photo.qrPayload) { %>
                      <div class="small text-secondary mb-3"><strong>QR:</strong> <code><%= photo.qrPayload %></code></div>
                    <% } %>

                    <form action="/admin/photos/<%= photo.id %>" method="post" class="d-grid gap-2">
                      <input type="hidden" name="batchId" value="<%= batch.id %>" />
                      <div>
                        <label class="form-label small">Teilnehmer</label>
                        <select class="form-select form-select-sm" name="participantId">
                          <option value="">Nicht zugeordnet</option>
                          <% participants.forEach((participant) => { %>
                            <option value="<%= participant.id %>" <%= photo.participantId === participant.id ? 'selected' : '' %>>
                              <%= participant.firstname %> <%= participant.lastname %>
                            </option>
                          <% }) %>
                        </select>
                      </div>
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="yes" id="badge-<%= photo.id %>" name="isBadge" <%= photo.isBadge ? 'checked' : '' %> />
                        <label class="form-check-label small" for="badge-<%= photo.id %>">Als QR-/Badgebild markieren</label>
                      </div>
                      <button class="btn btn-sm btn-outline-primary" type="submit">Foto speichern</button>
                      <a class="btn btn-sm btn-outline-secondary" href="<%= photo.fileUrl %>" target="_blank" rel="noreferrer">Original öffnen</a>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </section>
      <% }) %>
    </main>
  </body>
</html>
