<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/styles.css" rel="stylesheet" />
  </head>
  <body>
    <main class="container py-4 py-lg-5">
      <div class="row justify-content-center">
        <div class="col-lg-10">
          <div class="d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center mb-4">
            <div>
              <span class="badge text-bg-dark mb-2">Teilnehmergalerie</span>
              <h1 class="h3 mb-1"><%= participant.firstname %> <%= participant.lastname %></h1>
              <p class="text-secondary mb-0">Freigegebene Fotos aus <%= event.name %></p>
            </div>
            <div class="d-flex flex-wrap gap-2">
              <% if (photos.length > 0 && (!event.download || event.download.allowZip !== false)) { %>
                <a class="btn btn-primary" href="/api/events/<%= event.id %>/download/<%= participant.id %>?token=<%= participant.token %>">Alle als ZIP herunterladen</a>
              <% } %>
              <a class="btn btn-outline-secondary" href="/event/<%= event.slug %>">Neuen QR-Code scannen</a>
            </div>
          </div>

          <% if (!photos.length) { %>
            <div class="alert alert-warning">Aktuell sind noch keine bestätigten Fotos für diesen QR-Code verfügbar. Bitte später erneut versuchen.</div>
          <% } %>

          <div class="row g-4">
            <% photos.forEach((photo) => { %>
              <div class="col-sm-6 col-lg-4">
                <div class="panel-card card h-100">
                  <div class="card-body">
                    <button
                      class="gallery-trigger mb-3"
                      type="button"
                      data-bs-toggle="modal"
                      data-bs-target="#photoPreviewModal"
                      data-photo-preview="true"
                      data-full-image="<%= photo.fileUrl %>"
                      data-file-name="<%= photo.originalName %>"
                      data-download-url="/api/photos/<%= photo.id %>/download?token=<%= participant.token %>"
                    >
                      <img class="thumb-preview" src="<%= photo.thumbnailUrl %>" alt="Eventfoto <%= photo.originalName %>" loading="lazy" />
                    </button>
                    <div class="small text-secondary mb-3">Datei: <%= photo.originalName %></div>
                    <div class="d-grid gap-2">
                      <button
                        class="btn btn-outline-secondary"
                        type="button"
                        data-bs-toggle="modal"
                        data-bs-target="#photoPreviewModal"
                        data-photo-preview="true"
                        data-full-image="<%= photo.fileUrl %>"
                        data-file-name="<%= photo.originalName %>"
                        data-download-url="/api/photos/<%= photo.id %>/download?token=<%= participant.token %>"
                      >
                        Vorschau vergrößern
                      </button>
                      <a class="btn btn-outline-primary" href="/api/photos/<%= photo.id %>/download?token=<%= participant.token %>">Einzelbild herunterladen</a>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </main>

    <div class="modal fade" id="photoPreviewModal" tabindex="-1" aria-labelledby="photoPreviewTitle" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 shadow-lg">
          <div class="modal-header">
            <h2 class="h5 modal-title" id="photoPreviewTitle">Vergrößerte Vorschau</h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
          </div>
          <div class="modal-body">
            <img id="photoPreviewImage" class="gallery-preview-image" src="" alt="Vergrößerte Foto-Vorschau" />
          </div>
          <div class="modal-footer">
            <a id="photoPreviewDownload" class="btn btn-primary" href="#">Bild herunterladen</a>
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Schließen</button>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/app.js" defer></script>
  </body>
</html>
