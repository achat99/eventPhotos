<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/styles.css" rel="stylesheet" />
  </head>
  <body>
    <main class="container-fluid py-4 px-lg-4">
      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
          <span class="badge text-bg-dark mb-2">Adminbereich</span>
          <h1 class="h3 mb-1"><%= event.name %></h1>
          <p class="text-secondary mb-0">Upload, automatische QR-Zuordnung und Review-Freigabe.</p>
        </div>
        <form action="/admin/logout" method="post">
          <button class="btn btn-outline-secondary" type="submit">Abmelden</button>
        </form>
      </div>

      <% if (message) { %>
        <div class="alert alert-success"><%= message %></div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3"><div class="panel-card card"><div class="card-body"><div class="text-secondary small">Teilnehmer</div><div class="display-6 fw-bold"><%= stats.participants %></div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="panel-card card"><div class="card-body"><div class="text-secondary small">Upload-Batches</div><div class="display-6 fw-bold"><%= stats.batches %></div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="panel-card card"><div class="card-body"><div class="text-secondary small">Eventfotos</div><div class="display-6 fw-bold"><%= stats.photos %></div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="panel-card card"><div class="card-body"><div class="text-secondary small">Offene Reviews</div><div class="display-6 fw-bold"><%= stats.pendingBatches %></div></div></div></div>
      </div>

      <div class="row g-4">
        <div class="col-xl-5">
          <div class="panel-card card h-100">
            <div class="card-body p-4">
              <h2 class="h4 mb-3">Neuen Batch hochladen</h2>
              <p class="text-secondary">Ordner- oder Mehrfach-Upload. Die Verarbeitung erfolgt sequenziell nach Dateiname.</p>
              <form action="/api/events/<%= event.id %>/upload" method="post" enctype="multipart/form-data" class="d-grid gap-3">
                <input class="form-control" type="file" name="images" accept="image/*" webkitdirectory directory multiple required />
                <button class="btn btn-primary" type="submit">Batch analysieren</button>
              </form>
            </div>
          </div>
        </div>

        <div class="col-xl-7">
          <div class="panel-card card h-100">
            <div class="card-body p-4">
              <h2 class="h4 mb-3">Teilnehmer</h2>
              <div class="table-responsive">
                <table class="table align-middle">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>QR-Token</th>
                      <th>Erstellt</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!participants.length) { %>
                      <tr><td colspan="3" class="text-secondary">Noch keine Teilnehmer registriert.</td></tr>
                    <% } %>
                    <% participants.forEach((participant) => { %>
                      <tr>
                        <td><strong><%= participant.firstname %> <%= participant.lastname %></strong></td>
                        <td><code><%= participant.token %></code></td>
                        <td><%= participant.createdAt %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="panel-card card mt-4">
        <div class="card-body p-4">
          <h2 class="h4 mb-3">Batches</h2>
          <div class="table-responsive">
            <table class="table align-middle">
              <thead>
                <tr>
                  <th>Erstellt</th>
                  <th>Status</th>
                  <th>Bilder</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% if (!batches.length) { %>
                  <tr><td colspan="4" class="text-secondary">Noch keine Upload-Batches vorhanden.</td></tr>
                <% } %>
                <% batches.forEach((batch) => { %>
                  <tr>
                    <td><%= batch.createdAt %></td>
                    <td><span class="badge text-bg-<%= batch.status === 'done' ? 'success' : 'warning' %>"><%= batch.status %></span></td>
                    <td><%= batch.processedImages %> / <%= batch.totalImages %></td>
                    <td class="text-end">
                      <a class="btn btn-sm btn-outline-primary" href="/admin/events/<%= event.slug %>/review?batch=<%= batch.id %>">Review öffnen</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="panel-card card mt-4 danger-zone-card">
        <div class="card-body p-4">
          <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
            <div>
              <h2 class="h4 text-danger mb-2">Gefahrenbereich</h2>
              <p class="text-secondary mb-1">Löscht alle hochgeladenen Bilder, Thumbnails und Batches aus dem System. Teilnehmer bleiben erhalten.</p>
              <div class="small text-danger">Dieser Vorgang ist unwiderruflich.</div>
            </div>
            <form action="/admin/events/<%= event.slug %>/delete-photos" method="post" onsubmit="return confirm('Wirklich alle Bilder und Upload-Batches unwiderruflich löschen?');">
              <button class="btn btn-outline-danger" type="submit" <%= !batches.length && !stats.photos ? 'disabled' : '' %>>Alle Bilder löschen</button>
            </form>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
