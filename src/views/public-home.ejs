<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/styles.css" rel="stylesheet" />
  </head>
  <body>
    <main class="container py-4 py-lg-5 site-shell">
      <div class="dj-site-header">
        <div class="dj-site-header-stripe"></div>
        <div class="dj-site-header-inner">
          <div class="dj-brand-block">
            <div class="dj-brand-box">DLRG</div>
            <div class="dj-brand-meta">
              <small>DLRG Jugend Schleswig-Holstein</small>
              <strong>Event-Fotos</strong>
            </div>
          </div>
          <div class="dj-site-claim">Bock auf gute Erinnerungen? Hier kannst du deine Event-Fotos abrufen.</div>
        </div>
      </div>

      <div class="row justify-content-center g-4">
        <div class="col-lg-10">
          <div class="hero-card card mb-4">
            <div class="card-body p-4 p-lg-5">
              <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
                <div>
                  <h1 class="display-6 fw-bold mb-2"><%= event.name %></h1>
                </div>
                <div class="text-lg-end">
                  <div class="small text-secondary">Datenschutz / Löschanfrage</div>
                  <a class="fw-semibold" href="mailto:<%= event.contactEmail %>"><%= event.contactEmail %></a>
                </div>
              </div>
            </div>
          </div>

          <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>

          <% if (message) { %>
            <div class="alert alert-success"><%= message %></div>
          <% } %>

          <div class="row g-4">
            <div class="col-lg-6">
              <div class="panel-card card h-100">
                <div class="card-body p-4">
                  <h2 class="h4 mb-3">1. QR-Code erstellen</h2>
                  <p class="text-secondary">Teilnehmer registrieren sich mit Vor- und Nachnamen sowie E-Mail-Adresse und erhalten ihren QR-Code plus Abruflink automatisch per Mail.</p>

                  <form action="/event/<%= event.slug %>/register" method="post" class="row g-3">
                    <div class="col-md-6">
                      <label class="form-label">Vorname</label>
                      <input class="form-control" name="firstname" required />
                    </div>
                    <div class="col-md-6">
                      <label class="form-label">Nachname</label>
                      <input class="form-control" name="lastname" required />
                    </div>
                    <div class="col-12">
                      <label class="form-label">E-Mail-Adresse</label>
                      <input class="form-control" type="email" name="email" placeholder="name@example.com" required />
                    </div>
                    <div class="col-12">
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="yes" id="consent" name="consent" required />
                        <label class="form-check-label" for="consent">
                          Ich bin über die Fotoverarbeitung informiert und stimme der Nutzung für dieses Event zu.
                        </label>
                      </div>
                    </div>
                    <div class="col-12 d-grid">
                      <button class="btn btn-primary btn-lg" type="submit">QR-Code erzeugen</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>

            <div class="col-lg-6">
              <div class="panel-card card h-100">
                <div class="card-body p-4">
                  <h2 class="h4 mb-3">2. Fotos abrufen</h2>
                  <p class="text-secondary">QR-Code per Kamera scannen oder Token manuell eingeben, um die freigegebenen Fotos anzuzeigen.</p>

                  <form id="lookupForm" action="/event/<%= event.slug %>/gallery" method="get" class="row g-3">
                    <div class="col-12">
                      <label class="form-label">Token / QR-Inhalt</label>
                      <input id="lookupToken" class="form-control" name="token" placeholder="QR-Code scannen oder Token einfügen" required />
                    </div>
                    <div class="col-12 d-grid gap-2">
                      <button class="btn btn-success" type="submit">Galerie öffnen</button>
                      <button id="start-scan-btn" class="btn btn-outline-secondary" type="button">QR-Code mit Kamera scannen</button>
                    </div>
                  </form>

                  <div id="scanner-status" class="small text-secondary mt-3">Optional: Scanner direkt im Browser starten.</div>
                  <div id="qr-scanner" class="d-none mt-3"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <script src="https://unpkg.com/html5-qrcode" defer></script>
    <script src="/app.js" defer></script>
  </body>
</html>
