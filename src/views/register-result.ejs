<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/styles.css" rel="stylesheet" />
  </head>
  <body>
    <main class="container py-4 py-lg-5 site-shell">
      <div class="dj-site-header">
        <div class="dj-site-header-stripe"></div>
        <div class="dj-site-header-inner">
          <div class="dj-brand-block">
            <div class="dj-brand-box">DLRG</div>
            <div class="dj-brand-meta">
              <small>DLRG Jugend</small>
              <strong>Dein Fotozugang</strong>
            </div>
          </div>
          <div class="dj-site-claim">Dein persönlicher QR-Code ist bereit – klar, direkt und passend zum Webauftritt der DLRG Jugend.</div>
        </div>
      </div>

      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="panel-card card">
            <div class="card-body p-4 p-lg-5 text-center">
              <span class="badge text-bg-success mb-3">Registrierung abgeschlossen</span>
              <h1 class="h3 mb-2"><%= participant.firstname %> <%= participant.lastname %></h1>
              <p class="text-secondary mb-3">Bitte den QR-Code speichern oder als Screenshot bereithalten. Er dient beim Fotografieren als Trennmarker.</p>

              <% if (message) { %>
                <div class="alert alert-success text-start"><%= message %></div>
              <% } %>

              <% if (error) { %>
                <div class="alert alert-warning text-start"><%= error %></div>
              <% } %>

              <div class="small text-secondary mb-3">
                Versandadresse: <strong><%= participant.email || 'keine E-Mail hinterlegt' %></strong>
              </div>

              <img class="qr-preview mb-4" src="<%= qrImagePath %>" alt="QR-Code für <%= participant.firstname %> <%= participant.lastname %>" />

              <div class="alert alert-light text-start small mb-4">
                <strong>Hinweis:</strong> Dieser QR-Code enthält direkt den persönlichen Link zur Galerie. Alternativ funktioniert auch dieser Abruflink:<br />
                <a href="<%= galleryUrl %>"><%= galleryUrl %></a>
              </div>

              <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                <a class="btn btn-primary" href="<%= qrImagePath %>" download="<%= participant.firstname %>-<%= participant.lastname %>-qr.png">QR-Code herunterladen</a>
                <a class="btn btn-outline-primary" href="<%= galleryUrl %>">Galerie-Link öffnen</a>
                <a class="btn btn-outline-secondary" href="/event/<%= event.slug %>">Zurück zur Startseite</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
