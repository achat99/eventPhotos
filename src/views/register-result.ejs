<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/styles.css" rel="stylesheet" />
  </head>
  <body>
    <main class="container py-4 py-lg-5">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="panel-card card">
            <div class="card-body p-4 p-lg-5 text-center">
              <span class="badge text-bg-success mb-3">Registrierung abgeschlossen</span>
              <h1 class="h3 mb-2"><%= participant.firstname %> <%= participant.lastname %></h1>
              <p class="text-secondary mb-4">Bitte den QR-Code speichern oder als Screenshot bereithalten. Er dient beim Fotografieren als Trennmarker.</p>

              <img class="qr-preview mb-4" src="<%= qrImagePath %>" alt="QR-Code für <%= participant.firstname %> <%= participant.lastname %>" />

              <div class="alert alert-light text-start small mb-4">
                <strong>Hinweis:</strong> Nach dem Event kann derselbe QR-Code erneut gescannt werden, um die freigegebenen Fotos aufzurufen.
              </div>

              <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                <a class="btn btn-primary" href="<%= qrImagePath %>" download="<%= participant.firstname %>-<%= participant.lastname %>-qr.png">QR-Code herunterladen</a>
                <a class="btn btn-outline-secondary" href="/event/<%= event.slug %>">Zurück zur Startseite</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
